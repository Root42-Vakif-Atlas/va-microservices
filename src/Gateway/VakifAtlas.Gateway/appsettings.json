{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Yarp": "Warning"
      }
    }
  },
  "Http": {
    "MaxRequestBodyBytes": 1048576,
    "ForwardedHeaders": {
      "KnownNetworks": []
    }
  },
  "Gateway": {
    "Cors": {
      "Origins": []
    },
    "RateLimits": {
      "DefaultBurst": 120,
      "DefaultPerSecond": 20,
      "AuthPerMinute": 30
    },
    "Services": {}
  },
  "AllowedHosts": "*"
}
